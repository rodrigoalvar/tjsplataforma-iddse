# ============================================
# CLOUD STORAGE - Cloudflare R2
# Configuración del módulo Cloud Storage
# ============================================
# 
# Copia este archivo a .env y completa con tus credenciales
# cp .env.example .env
#

# Habilitar/deshabilitar el módulo
R2_ENABLED=false

# Credenciales de Cloudflare R2
R2_ACCOUNT_ID=tu_account_id_aqui
R2_ACCESS_KEY=tu_access_key_aqui
R2_SECRET_KEY=tu_secret_key_aqui

# Configuración del bucket
R2_BUCKET_NAME=dicom-studies
R2_REGION=auto

# Dominio personalizado (opcional, para URLs presignadas)
# Si no se configura, se usará el endpoint interno de R2
R2_CUSTOM_DOMAIN=https://r2.tanjousoft.com.ar

# Prefijo para almacenamiento en R2
R2_STORAGE_PREFIX=studies/

# Configuración de procesamiento
R2_UPLOAD_CONCURRENCY=2
R2_PRESIGNED_TTL=600

# ============================================
# NOTAS:
# - R2_ENABLED debe ser 'true' para activar el módulo
# - R2_ACCOUNT_ID se encuentra en Cloudflare Dashboard > R2 > Manage R2 API Tokens
# - R2_ACCESS_KEY y R2_SECRET_KEY se generan al crear un API Token en Cloudflare
# - R2_CUSTOM_DOMAIN debe apuntar a tu bucket R2 (configurar en Cloudflare)
# - R2_UPLOAD_CONCURRENCY: número de estudios a procesar en paralelo
# - R2_PRESIGNED_TTL: tiempo de vida de URLs presignadas en segundos (default: 600 = 10 min)
# ============================================
