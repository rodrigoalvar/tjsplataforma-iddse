{
    "name": "tjsmedical/email-module",
    "description": "Módulo independiente de envíos por email para sistemas TJSMEDICAL",
    "type": "library",
    "version": "1.0.0",
    "license": "MIT",
    "authors": [
        {
            "name": "TJSMEDICAL",
            "email": "info@tjsmedical.com"
        }
    ],
    "require": {
        "php": ">=7.4",
        "phpmailer/phpmailer": "^6.8"
    },
    "autoload": {
        "psr-4": {
            "EmailModule\\": ""
        },
        "files": [
            "EmailConfig.php",
            "EmailService.php",
            "EmailTemplate.php",
            "EmailEventManager.php"
        ]
    },
    "config": {
        "vendor-dir": "vendor",
        "optimize-autoloader": true
    },
    "scripts": {
        "test": "php tests/test-email.php",
        "install-deps": "composer install"
    }
}

