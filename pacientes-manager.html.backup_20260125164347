    <!-- Sidebar Scripts -->
    <script>
        // Sidebar toggle functionality
        document.addEventListener('DOMContentLoaded', function() {
            // Agregar parámetro return al enlace de Gestión Mensajes
            const linkGestionMensajes = document.getElementById('linkGestionMensajes');
            if (linkGestionMensajes) {
                const currentPage = window.location.pathname.split('/').pop() || 'pacientes-manager.html';
                linkGestionMensajes.href = 'modules/email/admin.php?return=' + encodeURIComponent(currentPage);
            }
            
            const sidebar = document.getElementById('sidebar');
            const sidebarToggle = document.getElementById('sidebarToggle');
            const sidebarToggleDesktop = document.getElementById('sidebarToggleDesktop');
            const sidebarToggleShow = document.getElementById('sidebarToggleShow');
            const sidebarOverlay = document.getElementById('sidebarOverlay');
            const sidebarLayout = document.getElementById('sidebarLayout');
            
            // Mobile toggle
            if (sidebarToggle) {
                sidebarToggle.addEventListener('click', function() {
                    sidebar.classList.toggle('show');
                    if (sidebarOverlay) {
                        sidebarOverlay.classList.toggle('show');
                    }
                });
            }
            
            // Desktop toggle - ocultar sidebar
            if (sidebarToggleDesktop) {
                sidebarToggleDesktop.addEventListener('click', function() {
                    if (sidebarLayout) {
                        sidebarLayout.classList.add('sidebar-hidden');
                    }
                });
            }
            
            // Desktop toggle - mostrar sidebar
            if (sidebarToggleShow) {
                sidebarToggleShow.addEventListener('click', function() {
                    if (sidebarLayout) {
                        sidebarLayout.classList.remove('sidebar-hidden');
                    }
                });
            }
            
            // Overlay click (mobile)
            if (sidebarOverlay) {
                sidebarOverlay.addEventListener('click', function() {
                    sidebar.classList.remove('show');
                    sidebarOverlay.classList.remove('show');
                });
            }
            
            // Close sidebar on nav link click (mobile)
            document.querySelectorAll('.sidebar .nav-link').forEach(link => {
                link.addEventListener('click', function() {
                    if (window.innerWidth < 992) {
                        sidebar.classList.remove('show');
                        if (sidebarOverlay) {
                            sidebarOverlay.classList.remove('show');
                        }
                    }
                });
            });
            
            // Handle active navigation state
            function setActiveNavLink() {
                const currentPath = window.location.pathname;
                const currentPage = currentPath.split('/').pop() || 'pacientes-manager.html';
                const navLinks = document.querySelectorAll('.sidebar .nav-link');
                
                // Remover 'active' de TODOS los enlaces primero
                navLinks.forEach(link => {
                    link.classList.remove('active');
                });
                
                // Verificar si estamos en admin.php
                if (currentPath.includes('modules/email/admin.php')) {
                    // Si estamos en admin.php, marcar "Gestión Mensajes" como activo
                    navLinks.forEach(link => {
                        const href = link.getAttribute('href');
                        if (href && (href.includes('modules/email/admin.php') || href.includes('admin.php'))) {
                            link.classList.add('active');
                        }
                    });
                } else {
                    // Para otras páginas, marcar el enlace correspondiente
                    navLinks.forEach(link => {
                        const href = link.getAttribute('href');
                        if (href && !href.includes('modules/email/admin.php') && !href.includes('admin.php')) {
                            // Comparar href con la página actual
                            if (href === currentPage || href.endsWith(currentPage) || 
                                (href.includes(currentPage.split('.')[0]) && !href.includes('admin.php'))) {
                                link.classList.add('active');
                            }
                        }
                    });
                }
            }
            
            // Set active nav link on page load
            setActiveNavLink();
        });
    </script>
