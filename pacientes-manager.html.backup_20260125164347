    <script>
        // Proteger página - requiere autenticación y permisos
        document.addEventListener('DOMContentLoaded', async function() {
            const isAuthenticated = await requireAuth();
            if (!isAuthenticated) {
                return; // La función requireAuth ya maneja la redirección
            }
            
            // Verificar permisos específicos para Gestión Pacientes usando la API simplificada
            const hasAccess = await requirePermissionSimple('pacientes', 'Gestión Pacientes', {
                title: 'Acceso Denegado - Gestión Pacientes',
                message: 'No tienes permisos para acceder a <strong>Gestión Pacientes</strong>.',
                redirectUrl: 'dashboard-unified.html',
                showLogoutButton: true
            });
            
            // Si no tiene permisos, no continuar con el resto del código
            if (!hasAccess) {
                return;
            }
            
            // Si tiene permisos, inicializar el gestor de pacientes
            if (window.initPacientesManager) {
                window.initPacientesManager();
            }
            
            // Actualizar nombre de usuario en sidebar
            updateWelcomeMessage();
        });

        async function updateWelcomeMessage() {
            try {
                await new Promise(resolve => setTimeout(resolve, 100));
                
                if (window.getCurrentUser) {
                    const user = window.getCurrentUser();
                    
                    if (user && user.nombre) {
                        const welcomeTitle = document.getElementById('welcomeTitle');
                        if (welcomeTitle) {
                            const fullName = user.apellido ? `${user.nombre} ${user.apellido}` : `${user.nombre}`;
                            welcomeTitle.textContent = `Gestión de Pacientes - ${fullName}`;
                        }
                        
                        const sidebarUserName = document.querySelector('.sidebar-user .user-name');
                        if (sidebarUserName) {
                            const fullName = user.apellido ? `Dr. ${user.nombre} ${user.apellido}` : `Dr. ${user.nombre}`;
                            sidebarUserName.textContent = fullName;
                        }
                    }
                } else {
                    setTimeout(updateWelcomeMessage, 500);
                }
            } catch (error) {
                setTimeout(updateWelcomeMessage, 1000);
            }
        }
    </script>

