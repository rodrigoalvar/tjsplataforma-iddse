    <!-- Sidebar Scripts -->
    <script>
        // Sidebar toggle functionality
        // Function to load logo from configuration
        async function loadWelcomeLogo() {
            try {
                const logoElement = document.getElementById('welcomeLogo');
                if (!logoElement) return;
                
                const configResponse = await fetch('api/config/get-app-config.php');
                const configData = await configResponse.json();
                
                if (configData.success && configData.logo) {
                    logoElement.src = configData.logo;
                    logoElement.style.display = 'block';
                } else {
                    logoElement.style.display = 'none';
                }
            } catch (error) {
                console.error('Error cargando logo de configuración:', error);
                const logoElement = document.getElementById('welcomeLogo');
                if (logoElement) {
                    logoElement.style.display = 'none';
                }
            }
        }

        document.addEventListener('DOMContentLoaded', function() {
            // Cargar logo desde configuración
            loadWelcomeLogo();
            
            const sidebar = document.getElementById('sidebar');
            const sidebarToggle = document.getElementById('sidebarToggle');
            const sidebarToggleDesktop = document.getElementById('sidebarToggleDesktop');
            const sidebarToggleShow = document.getElementById('sidebarToggleShow');
            const sidebarOverlay = document.getElementById('sidebarOverlay');
            const sidebarLayout = document.getElementById('sidebarLayout');
            
            // Mobile toggle
            if (sidebarToggle) {
                sidebarToggle.addEventListener('click', function() {
                    sidebar.classList.toggle('show');
                    if (sidebarOverlay) {
                        sidebarOverlay.classList.toggle('show');
                    }
                });
            }
            
            // Desktop toggle - ocultar sidebar
            if (sidebarToggleDesktop) {
                sidebarToggleDesktop.addEventListener('click', function() {
                    if (sidebarLayout) {
                        sidebarLayout.classList.add('sidebar-hidden');
                    }
                });
            }
            
            // Desktop toggle - mostrar sidebar
            if (sidebarToggleShow) {
                sidebarToggleShow.addEventListener('click', function() {
                    if (sidebarLayout) {
                        sidebarLayout.classList.remove('sidebar-hidden');
                    }
                });
            }
            
            // Overlay click (mobile)
            if (sidebarOverlay) {
                sidebarOverlay.addEventListener('click', function() {
                    sidebar.classList.remove('show');
                    sidebarOverlay.classList.remove('show');
                });
            }
            
            // Close sidebar on nav link click (mobile)
            document.querySelectorAll('.sidebar .nav-link').forEach(link => {
                link.addEventListener('click', function() {
                    if (window.innerWidth < 992) {
                        sidebar.classList.remove('show');
                        if (sidebarOverlay) {
                            sidebarOverlay.classList.remove('show');
                        }
                    }
                });
            });
        });
    </script>
    
    <!-- Botón flotante para volver al inicio -->
    <button class="scroll-to-top-btn" id="scrollToTopBtn" title="Volver al inicio" aria-label="Volver al inicio">
        <i class="fas fa-arrow-up"></i>
    </button>
    
    <script>
        // Funcionalidad del botón "Volver al inicio"
        (function() {
            function initScrollToTop() {
                const scrollToTopBtn = document.getElementById('scrollToTopBtn');
                if (!scrollToTopBtn) {
                    setTimeout(initScrollToTop, 100);
                    return;
                }
                
                const mainContent = document.querySelector('.main-content');
                const containerFluid = document.querySelector('.main-content .container-fluid, .pacientes-container');
                
                function getScrollPosition() {
                    const windowScroll = window.pageYOffset || document.documentElement.scrollTop || document.body.scrollTop || 0;
                    let containerScroll = 0;
                    if (mainContent && mainContent.scrollTop) {
                        containerScroll = mainContent.scrollTop;
                    }
                    if (containerFluid && containerFluid.scrollTop) {
                        containerScroll = Math.max(containerScroll, containerFluid.scrollTop);
                    }
                    return Math.max(windowScroll, containerScroll);
                }
                
                function toggleScrollButton() {
                    const scrollTop = getScrollPosition();
                    if (scrollTop > 200) {
                        scrollToTopBtn.classList.add('show');
                    } else {
                        scrollToTopBtn.classList.remove('show');
                    }
                }
                
                function scrollToTop(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    const scrollOptions = { top: 0, behavior: 'smooth' };
                    window.scrollTo(scrollOptions);
                    if (document.documentElement) document.documentElement.scrollTo(scrollOptions);
                    if (document.body) document.body.scrollTo(scrollOptions);
                    if (mainContent) mainContent.scrollTo(scrollOptions);
                    if (containerFluid) containerFluid.scrollTo(scrollOptions);
                }
                
                window.addEventListener('scroll', toggleScrollButton, { passive: true });
                document.addEventListener('scroll', toggleScrollButton, { passive: true });
                if (mainContent) mainContent.addEventListener('scroll', toggleScrollButton, { passive: true });
                if (containerFluid) containerFluid.addEventListener('scroll', toggleScrollButton, { passive: true });
                scrollToTopBtn.addEventListener('click', scrollToTop);
                setTimeout(toggleScrollButton, 500);
                setInterval(toggleScrollButton, 1000);
            }
            
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', initScrollToTop);
            } else {
                initScrollToTop();
            }
        })();
    </script>
